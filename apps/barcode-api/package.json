{
    "name": "sahidawa-barcode-api",
    "version": "1.0.0",
    "private": true,
    "description": "Resolves a product barcode (GTIN) to a product, using SahiDawa's catalogue and medicine data.",
    "main": "dist/index.js",
    "scripts": {
        "start": "node dist/index.js",
        "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
        "build": "tsc",
        "test": "jest --forceExit --silent",
        "test:types": "tsc --noEmit"
    },
    "dependencies": {
        "@supabase/supabase-js": "2.108.2",
        "cors": "2.8.5",
        "dotenv": "17.4.2",
        "express": "5.2.1",
        "express-rate-limit": "8.5.2",
        "helmet": "8.2.0",
        "ioredis": "5.11.1",
        "rate-limit-redis": "5.0.0",
        "winston": "3.19.0"
    },
    "devDependencies": {
        "@babel/core": "7.29.7",
        "@babel/preset-env": "7.26.0",
        "@babel/preset-typescript": "7.26.0",
        "@types/cors": "2.8.17",
        "@types/express": "5.0.0",
        "@types/jest": "29.5.12",
        "@types/node": "20.19.9",
        "@types/supertest": "7.2.0",
        "babel-jest": "29.7.0",
        "jest": "29.7.0",
        "supertest": "7.2.2",
        "ts-node-dev": "2.0.0",
        "typescript": "5.6.2"
    }
}
