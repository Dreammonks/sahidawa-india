{
    "name": "sahidawa-india",
    "version": "1.1.0",
    "private": true,
    "description": "Medicine data pipeline and barcode lookup API for Bharat",
    "engines": {
        "node": ">=22.0.0"
    },
    "workspaces": [
        "apps/*"
    ],
    "scripts": {
        "dev": "npm run dev -w sahidawa-barcode-api",
        "build": "npm run build -w sahidawa-barcode-api",
        "test": "npm run test -w sahidawa-barcode-api",
        "lint": "npm run lint --workspaces --if-present",
        "lint:circular": "npx madge --circular --ts-config apps/barcode-api/tsconfig.json apps/barcode-api/src",
        "prepare": "husky || true",
        "check:migrations": "node scripts/check-migrations.js",
        "audit:node": "npm audit -w sahidawa-barcode-api --audit-level=high",
        "audit:python": "node scripts/audit-python.js",
        "audit:all": "npm run audit:node && npm run audit:python"
    },
    "keywords": [
        "medicine",
        "barcode",
        "health",
        "cdsco"
    ],
    "author": "",
    "license": "MIT",
    "packageManager": "npm@11.12.1",
    "devDependencies": {
        "husky": "^9.1.7",
        "lint-staged": "^17.0.8",
        "madge": "^8.0.0",
        "prettier": "^3.9.4"
    },
    "overrides": {
        "typescript": "5.6.2",
        "postcss": "^8.5.15",
        "form-data": "^4.0.6"
    },
    "lint-staged": {
        "*.{ts,js,md,json}": "prettier --write"
    }
}
